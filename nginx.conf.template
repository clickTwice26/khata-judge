server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Health check endpoint for Cubicle
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "OK\n";
    }

    # Single-page application router fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
